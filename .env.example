# Turso / libSQL — https://turso.tech
TURSO_DATABASE_URL=libsql://sorrycheck-profullstack.aws-us-west-2.turso.io
TURSO_AUTH_TOKEN=

# Public origin. Passkey rpID is derived from this, so it must match the host
# users actually visit or credentials will not resolve.
SITE_URL=https://sorrycheck.com

# Email (Resend) — magic links. Without it, sign-in links cannot be delivered.
RESEND_API_KEY=
MAIL_FROM=sorrycheck <hello@sorrycheck.com>

# Session signing
SESSION_SECRET=

# Worker
WORKER_ENABLED=true
WORKER_INTERVAL_MS=60000
